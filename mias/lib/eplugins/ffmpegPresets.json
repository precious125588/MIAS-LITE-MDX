{
  "nonanimated": [
    "-y",
    "-vcodec libwebp",
    "-vf",
    "scale=2006:2006:flags=lanczos:force_original_aspect_ratio=decrease,format=rgba,pad=2006:2006:(ow-iw)/2:(oh-ih)/2:color=#00000000,setsar=1"
  ],
  "newnonanimated": [
    "-vcodec",
    "libwebp",
    "-vf",
    "crop=w='min(min(iw,ih),512)':h='min(min(iw,ih),512)',scale=2006:2006,setsar=1"
  ],
  "animated2": [
    "-t",
    "15",
    "-vf",
    "scale=512:512:force_original_aspect_ratio=decrease,pad=512:512:(ow-iw)/2:(oh-ih)/2:color=white@0,fps=15",
    "-c:v",
    "libwebp",
    "-lossless",
    "0",
    "-loop",
    "1",
    "-preset",
    "default",
    "-an",
    "-pix_fmt",
    "yuva420p"
  ],
  "animated1": [
    "-y",
    "-vf",
    "scale=512:512:flags=lanczos:force_original_aspect_ratio=decrease,format=rgba,pad=512:512:(ow-iw)/2:(oh-ih)/2:color=#00000000,setsar=1,fps=20",
    "-lossless 0",
    "-preset default",
    "-loop 0",
    "-an",
    "-vsync 0",
    "-s 512:512"
  ],
  "newanimated1": [
    "-vcodec",
    "libwebp",
    "-vf",
    "crop=w='min(min(iw,ih),512)':h='min(min(iw,ih),512)',scale=512:512,setsar=1",
    "-loop",
    "0",
    "-lossless 1",
    "-preset",
    "default",
    "-an",
    "-vsync",
    "0",
    "-s",
    "512:512"
  ],
  "newanimated2": [
    "-vcodec",
    "libwebp",
    "-vf",
    "crop=w='min(min(iw,ih),512)':h='min(min(iw,ih),512)',scale=512:512,setsar=1,fps=20",
    "-loop",
    "0",
    "-lossless 0",
    "-preset",
    "default",
    "-an",
    "-vsync",
    "0",
    "-s",
    "512:512"
  ],
  "left": [
    "-vf",
    "transpose=2"
  ],
  "right": [
    "-vf",
    "transpose=1"
  ],
  "flip": [
    "-vf",
    "transpose=2,transpose=2"
  ],
  "videor": [
    "-y",
    "-vf",
    "reverse",
    "-af",
    "areverse"
  ],
  "audior": [
    "-y",
    "-af",
    "areverse"
  ],
  "compress": [
    "-vcodec",
    "libx265",
    "-crf",
    "28"
  ],
  "mp3": [
    "-vn",
    "-acodec",
    "libmp3lame",
    "-q:a",
    "2"
  ],
  "wamp4": [
    "-c:v",
    "copy",
    "-c:a",
    "aac",
    "-movflags",
    "+faststart"
  ],
  "opus": [
    "-vn",
    "-map_metadata",
    "-1",
    "-acodec",
    "libopus",
    "-ac",
    "1",
    "-ar",
    "48000",
    "-b:a",
    "64k",
    "-f",
    "ogg"
  ],
  "m4a": [
    "-vn",
    "-c:a",
    "copy"
  ],
  "mp3_high": [
    "-vn",
    "-acodec",
    "libmp3lame",
    "-b:a",
    "256k"
  ],
  "tts": [
    "-vn",
    "-acodec",
    "libopus"
  ],
  "photo": [],
  "lowmp3": [
    "-y",
    "-af",
    "asetrate=44100*1.3",
    "-c:a",
    "libmp3lame",
    "-q:a",
    "2"
  ],
  "avec": [
    "-y",
    "-filter_complex",
    "[0:a]avectorscope=s=720x1280:rf=5:gf=25:bf=5:draw=line,format=yuv420p[v]",
    "-map",
    "[v]",
    "-map 0:a"
  ],
  "pitch": [
    "-y",
    "-af",
    "asetrate=44100*0.9",
    "-c:a",
    "libmp3lame",
    "-q:a",
    "2"
  ],
  "bass": [
    "-y",
    "-af",
    "bass=g=10"
  ],
  "treble": [
    "-y",
    "-af",
    "treble=g=10"
  ],
  "histo": [
    "-filter_complex",
    "[0:a]ahistogram=s=hd480:slide=scroll:scale=log,format=yuv420p[v]",
