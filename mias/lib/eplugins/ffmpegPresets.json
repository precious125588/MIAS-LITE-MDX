    "[v]",
    "-map",
    "0:a",
    "-b:a",
    "360k"
  ],
  "vector": [
    "-filter_complex",
    "[0:a]avectorscope=s=512x512:zoom=1.5:rc=0:gc=200:bc=0:rf=0:gf=40:bf=0,format=yuv420p[v]",
    "-map",
    "[v]",
    "-map",
    "0:a",
    "-b:v",
    "700k",
    "-b:a",
    "360k"
  ],
  "crop": [
    "-y",
    "-vf",
    "crop=cw:ch:w:h"
  ]
