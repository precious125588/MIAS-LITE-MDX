# ==========================================================
# MIAS / PRECIOUS bot - environment template
# Copy this to your host's variables (Railway > Variables).
# Never commit a real .env file. Use placeholders here only.
# ==========================================================

# ---- Storage ----------------------------------------------
# json (default): bot data lives in JSON files on the volume.
# postgres: re-enables PostgreSQL/Redis code paths. Only set if you need them.
STORAGE_MODE=json

# ---- Bot identity -----------------------------------------
BOT_PHONE=
PREFIX=.
LOG_LEVEL=info
PORT=3000

# ---- Owner / admins ---------------------------------------
# Your WhatsApp number, digits only, with country code (e.g. 2348012345678)
OWNER_NUMBER=REPLACE_WITH_OWNER_NUMBER
OWNER_NAME=
# Optional: owner WhatsApp JID or LID if the number alone does not match
OWNER_JID=
OWNER_LID=
# Optional: comma-separated Telegram/admin IDs
ADMIN_IDS=

# ---- Web admin panel (server.js) --------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ---- WhatsApp session / pairing ---------------------------
# Opaque SESSION_ID values must resolve through the public session service that issued them.
# Set SESSION_SERVER_URL to that service's public HTTPS base URL (not localhost).
SESSION_ID=
SESSION_SERVER_URL=
# Folder for WhatsApp auth files. On Railway, point this at the mounted volume.
SESSION_DIR=
AUTH_DIR=
# Optional custom pairing code (set USE_CUSTOM_PAIRING_CODE=true to use it)
USE_CUSTOM_PAIRING_CODE=false
PAIRING_CODE=

# ---- Telegram (optional) ----------------------------------
TELEGRAM_BOT_TOKEN=
REQUIRED_GROUP=
REQUIRED_CHANNELS=

# ---- Panel / store info (optional) ------------------------
PANEL_URL=
PANEL_NAME=
PANEL_DESC=
PANEL_PRICE=
PANEL_CONTACT=
LOGO_URL=

# ---- Third-party API keys (optional, leave blank to skip) -
YOUTUBE_API_KEY=
GEMINI_KEY=
ASSEMBLYAI_KEY=
DEEPGRAM_KEY=
REPLICATE_TOKEN=
JAMENDO_CLIENT_ID=

# ---- Media / downloads ------------------------------------
MAX_DOWNLOAD_BYTES=5368709120
FFMPEG_PATH=ffmpeg
DOWNLOAD_DIR=
MIAS_EXPORT_DIR=

# ---- Legacy PostgreSQL / Redis (ignored unless STORAGE_MODE=postgres) ----
# DATABASE_URL=REPLACE_WITH_POSTGRES_URL
# SESSION_DATABASE_URL=REPLACE_WITH_POSTGRES_SESSION_URL
# RAILWAY_DATABASE_URL=
# RAILWAY_SESSION_DATABASE_URL=
# RAILWAY_DATABASE_SSL=require
# RAILWAY_DATABASE_SSL_VERIFY=true
# REDIS_URL=REPLACE_WITH_REDIS_URL
