# ============================================================
# MIAS LITE MDX - Environment Configuration
# ============================================================

# ---- Telegram Stickers (.tgs) -----------------------------
# Paste your Telegram Bot Token from @BotFather here.
# Or send  .settoken <token>  to the bot in WhatsApp; that copy survives restarts and updates.
TELEGRAM_BOT_TOKEN=

# ---- Server -----------------------------------------------
PORT=3000

# ---- Anti-Idle / Keep-Alive (Free Tier Render & Railway) --
# APP_URL=https://your-bot-name.onrender.com
# SELF_PING_INTERVAL_MINUTES=8

# ---- Admin Credentials (for web dashboard) ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ---- WhatsApp session / pairing ---------------------------
# SESSION_ID supports:
# 1. Self-contained base64 credentials: JUST_X~<base64>
# 2. Short session tokens: JUST_X~<token>
# 3. Embedded URL tokens: JUST_X~https://session-service.up.railway.app~<token>
SESSION_ID=

# Folder for WhatsApp auth files
SESSION_DIR=/app/nexstore/pairing

# ---- Databases (Optional) ---------------------------------
STORAGE_MODE=json
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Bot Identity -----------------------------------------
CREATOR_USERNAME=precious125588
TIKWM_ENABLED=0
