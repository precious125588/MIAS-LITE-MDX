# ============================================================
# MIAS LITE MDX - Environment Configuration
# ============================================================

# ---- Server -----------------------------------------------
PORT=3000

# ---- Admin Credentials (for web dashboard) ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# ---- WhatsApp session / pairing ---------------------------
# SESSION_ID supports:
# 1. Self-contained base64 credentials: JUST_X~<base64> (zero-server, works anywhere offline/online)
# 2. Short session tokens: JUST_X~<token> (automatically resolves from localhost, Railway private network, or SESSION_SERVER_URL)
# 3. Embedded URL tokens: JUST_X~https://session-service.up.railway.app~<token>
SESSION_ID=
# (Optional) Explicit session server URL if using an external session generator:
# SESSION_SERVER_URL=https://your-session-service.up.railway.app

# Folder for WhatsApp auth files. On Railway, mount a persistent volume at /app/nexstore.
SESSION_DIR=/app/nexstore/pairing
# Leave AUTH_DIR unset on the dashboard; the launcher assigns a per-number directory.
# Do not run the same companion credentials in multiple services or replicas.
# RESET_SESSIONS/PURGE_ALL_SESSIONS/DISCARD_SESSIONS delete auth only when explicitly set.

# ---- Databases (Optional) ---------------------------------
STORAGE_MODE=json
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ---- Bot Identity -----------------------------------------
CREATOR_USERNAME=precious125588
